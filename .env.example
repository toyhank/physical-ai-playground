# Frontend (browser-safe; no secrets)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend (copy these values to server/.env.local for local development)
MODEL_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-robotics-er-2-preview
MAX_AGENT_STEPS=15
MAX_TASK_SECONDS=60
MAX_SESSIONS=4
SESSION_IDLE_SECONDS=120
TASKS_PER_HOUR=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
