# Frontend (browser-safe; no secrets)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PUBLIC_DEMO=false

# Backend (copy these values to server/.env.local for local development)
MODEL_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-robotics-er-2-preview
VLA_PROVIDER=mock
VLA_POLICY_PATH=ahmedsohail2003/smolvla-so101-pickplace-v2
VLA_TASK_PROMPT=Pick up the red block and place it in the blue tray.
VLA_POLICY_JOINT_OFFSETS=0,1.5707963268,-1.5707963268,0,1.5707963268,0
VLA_DEVICE=cuda
VLA_HOST=http://127.0.0.1:8100
MAX_AGENT_STEPS=15
VLA_MAX_STEPS=240
MAX_TASK_SECONDS=60
MAX_SESSIONS=4
SESSION_IDLE_SECONDS=120
TASKS_PER_HOUR=10
PUBLIC_VLA_ONLY=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
